{
  "name": "delivra",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start2": "node ./scripts/start-expo.cjs",
    "s": "bun expo start --dev-client --host lan",
    "start": "bun expo start --dev-client --host lan",
    "sc": "node ./scripts/start-expo.cjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-debug.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1",
    "android": "bun expo run:android",
    "android:prebuild": "npx expo prebuild && bun expo run:android",
    "ios": "bun expo run:ios",
    "ios:prebuild": "npx expo prebuild && bun expo run:ios",
    "web": "bun run expo start --web",
    "test": "bun run jest --watchAll",
    "format": "bun run prettier --write .",
    "format:check": "bun run prettier --check .",
    "clean": "rm -rf node_modules; rm -rf ios/build; rm -rf ios/build; rm -rf ios/Pods; rm -rf ios/Podfile.lock; rm -rf ~/Library/Developer/Xcode/DerivedData/",
    "lint": "eslint ."
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/native": "^7.1.6",
    "@rnmapbox/maps": "^10.1.41",
    "expo": "~53.0.23",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "^5.2.4",
    "expo-font": "~13.3.1",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.7",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.2.0",
    "nativewind": "^4.1.23",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-mmkv": "2.12.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.37.0",
    "@react-native-community/cli": "^13.6.8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.4.0",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.5",
    "prettier": "^3.5.3",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "3.3.2",
    "typescript": "~5.8.3"
