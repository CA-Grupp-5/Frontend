# Mapbox configuration
# Replace with your public token (starts with pk.)
MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Mapbox downloads token for Android Maven (secret; starts with sk.)
MAPBOX_DOWNLOADS_TOKEN=sk.your_token_here

# Auth API endpoint and credentials (used by app login)
# Use full URL with https:// or without both work
POSTGRES_URL=https://your-api-host/



